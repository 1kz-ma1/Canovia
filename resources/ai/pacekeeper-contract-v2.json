{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://canovia.local/contracts/ai-plan-v2.json",
  "title": "Canovia AI contract 2.0",
  "type": "object",
  "required": [
    "schema_version",
    "flow",
    "target_plan",
    "summary",
    "operations"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "flow": {
      "enum": [
        "plan_generation",
        "plan_update",
        "result_recording"
      ]
    },
    "target_plan": {
      "type": "object",
      "required": [
        "id",
        "title"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 60,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "taskStatus": {
      "enum": [
        "todo",
        "doing",
        "done"
      ]
    },
    "taskReference": {
      "type": "object",
      "oneOf": [
        {
          "required": [
            "task_id"
          ],
          "properties": {
            "task_id": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "required": [
            "task_ref"
          ],
          "properties": {
            "task_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ]
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "const": "update_plan"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": {
              "type": "string"
            },
            "category": {
              "type": [
                "string",
                "null"
              ]
            },
            "start_date": {
              "type": "string",
              "format": "date"
            },
            "deadline": {
              "type": "string",
              "format": "date"
            },
            "is_public": {
              "type": "boolean"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "worked_on",
            "actual_minutes",
            "outcome"
          ],
          "properties": {
            "type": {
              "const": "record_result"
            },
            "task_id": {
              "type": "integer",
              "minimum": 1
            },
            "task_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "worked_on": {
              "type": "string",
              "format": "date"
            },
            "actual_minutes": {
              "type": "integer",
              "minimum": 1
            },
            "difficulty": {
              "enum": [
                "easy",
                "normal",
                "hard",
                "stuck",
                null
              ]
            },
            "outcome": {
              "type": "string",
              "minLength": 1
            },
            "progress_after_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "remaining_minutes_after": {
              "type": "integer",
              "minimum": 0
            },
            "progress_reason": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "client_ref",
            "title",
            "estimated_minutes",
            "remaining_minutes",
            "progress_percent",
            "status",
            "priority"
          ],
          "properties": {
            "type": {
              "const": "add_task"
            },
            "client_ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": {
              "type": "string"
            },
            "estimated_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "remaining_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "progress_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "progress_reason": {
              "type": "string"
            },
            "progress_origin": {
              "enum": [
                "existing_work",
                "inherited_task",
                "new_work"
              ]
            },
            "source_task_ids": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1
              },
              "uniqueItems": true
            },
            "status": {
              "$ref": "#/$defs/taskStatus"
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reason": {
              "type": "string"
            },
            "activation_cost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "next_action_note": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "task_id"
          ],
          "properties": {
            "type": {
              "const": "revise_task"
            },
            "task_id": {
              "type": "integer",
              "minimum": 1
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "description": {
              "type": "string"
            },
            "estimated_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "remaining_minutes": {
              "type": "integer",
              "minimum": 0
            },
            "progress_percent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            },
            "progress_reason": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/taskStatus"
            },
            "priority": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "reason": {
              "type": "string"
            },
            "activation_cost": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            },
            "next_action_note": {
              "type": "string",
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "task_id",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "keep_task"
            },
            "task_id": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "task_id",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "archive_task"
            },
            "task_id": {
              "type": "integer",
              "minimum": 1
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "items",
            "reason"
          ],
          "properties": {
            "type": {
              "const": "reorder_tasks"
            },
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/taskReference"
              }
            },
            "reason": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
